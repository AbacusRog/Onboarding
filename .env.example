# Copy this file to .env and fill in your Supabase project details
# Find these in Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Postcode lookup (optional). Sign up free at https://ideal-postcodes.co.uk — 50 free
# credits, no card required. If left blank, the postcode lookup box simply won't show,
# and clients can still fill in their address manually.
VITE_IDEAL_POSTCODES_API_KEY=your-ideal-postcodes-api-key
